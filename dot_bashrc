# shellcheck shell=bash
# If not running interactively, don't do anything (leave this at the top).
[[ $- != *i* ]] && return

# Load Omarchy defaults only when running on an Omarchy Linux installation.
if [[ $(uname -s) == Linux && -r "$HOME/.local/share/omarchy/default/bash/rc" ]]; then
    source "$HOME/.local/share/omarchy/default/bash/rc"
fi

if [[ -r "/opt/homebrew/etc/profile.d/bash_completion.sh" ]]; then
    source "/opt/homebrew/etc/profile.d/bash_completion.sh"
fi

if [[ -f "$HOME/.bash_aliases" ]]; then
    source "$HOME/.bash_aliases"
fi

# Keep a large history, append rather than overwrite, and avoid duplicates.
export HISTCONTROL=ignoreboth
export HISTSIZE=999999
export HISTFILESIZE=999999
# Don't save 1- or 2-letter commands, or space-started commands, or duplicates.
export HISTIGNORE='?:??: *:&'

# Append to the history file, don't overwrite it
shopt -s histappend
# Append to the history file after each command. Prompt hooks are shell-local.
PROMPT_COMMAND='history -a'
export -n PROMPT_COMMAND

# Disable Ctrl-S/Ctrl-Q terminal flow control.
stty -ixon 2>/dev/null

if [[ -d /opt/homebrew/bin ]]; then
    PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
fi
export PATH="${OMARCHY_PATH:+$OMARCHY_PATH/bin:}$HOME/.local/bin:$HOME/.cargo/bin:$HOME/bin:$HOME/opt:$PATH"
export PYTHONDONTWRITEBYTECODE=1

if [[ $(uname -s) == Linux && -S ${XDG_RUNTIME_DIR:-}/ssh-agent.socket ]]; then
    export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
fi

export PYENV_ROOT="${PYENV_ROOT:-$HOME/.pyenv}"
[[ -d "$PYENV_ROOT/bin" ]] && export PATH="$PYENV_ROOT/bin:$PATH"

if command -v pyenv >/dev/null 2>&1; then
    eval "$(pyenv init - bash)"

    if pyenv commands 2>/dev/null | command grep -qx virtualenv-init; then
        eval "$(pyenv virtualenv-init -)"
    fi
fi

activate() {
    if declare -F deactivate >/dev/null; then
        deactivate
    fi

    if [[ -d venv ]]; then
        source venv/bin/activate
    elif [[ -d .venv ]]; then
        source .venv/bin/activate
    else
        printf 'Error: no venv or .venv directory in current path\n' >&2
        return 1
    fi

    printf 'Activated %s\n' "$VIRTUAL_ENV"
}

unzd() {
    if (( $# != 1 )); then
        printf 'Usage: unzd FILE.zip\n' >&2
        return 1
    fi

    local target=${1%.zip}
    unzip "$1" -d "${target##*/}"
}

topf() {
    local dir=${1:-.}
    local num=${2:-10}
    du -ha "$dir" | sort -hr | command head -n "$num"
}

if [[ -r "$HOME/.bash_local" ]]; then
    source "$HOME/.bash_local"
fi

if command -v fzf >/dev/null 2>&1; then
    eval "$(fzf --bash)"
fi

if command -v direnv >/dev/null 2>&1; then
    eval "$(direnv hook bash)"
fi

if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
fi

if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi
